{
  "name": "gmcc-headless",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.20.0 <23.0.0"
  },
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "wpe-build": "node -v && npm -v && echo WPE_BUILD_STARTED && next build",
    "start": "next start -p 8080",
    "lint": "eslint",

    "preinstall": "node -e \"console.log('=== PREINSTALL ===', process.cwd())\"",
    "postinstall": "node -e \"console.log('=== POSTINSTALL ===')\""
  },
  "dependencies": {
    "graphql": "^16.11.0",
    "html-react-parser": "^5.2.6",
    "next": "^16.0.10",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.23",
    "eslint": "^9",
    "eslint-config-next": "^16.1.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
